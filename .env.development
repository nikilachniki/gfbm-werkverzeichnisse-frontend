# Gilt nur fuer "npm run dev", die Builds der Websites setzen ihre Werte selbst.
# Die Verwaltung arbeitet auch lokal mit dem echten Repo, deshalb hier das Test-Repo.
# Fuer ein anderes Repo die Variable in der Shell setzen, das geht dieser Datei vor.
VITE_DATA_REPO=nikilachniki/gfbm-werkverzeichnis-test
VITE_DATA_PATH=data
VITE_DATA_BRANCH=main
